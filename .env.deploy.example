# Copy to .env.deploy (gitignored). Used by scripts/deploy-landing.sh. Fill every value.
GODADDY_SFTP_HOST=
GODADDY_SFTP_USER=
GODADDY_SFTP_PASSWORD=
# Or use a key file instead of a password:
GODADDY_SFTP_KEY=
GODADDY_REMOTE_DIR=public_html
LANDING_DOMAIN=
# Optional, only if you script DNS changes through the GoDaddy API. The proxy never needs these.
GODADDY_API_KEY=
GODADDY_API_SECRET=
